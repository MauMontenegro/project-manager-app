VITE_API_URL=http://localhost:8000

# Inicio de sesión (correo y contraseña). En false, la API responde como la persona local (solo desarrollo).
VITE_AUTH_ENABLED=false
# Opcional: con VITE_FIREBASE_API_KEY se muestran además los botones de Google y Microsoft.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=innovacion-futuro.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=innovacion-futuro
# Opcional: restringe el inicio con Microsoft a un tenant de Entra ID
VITE_MICROSOFT_TENANT=
